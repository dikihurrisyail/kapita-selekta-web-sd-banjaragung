# ---------------------------------------------------------------------------
# Supabase
# Ambil dari: Dashboard Supabase > Project Settings > API
# Salin file ini menjadi .env.local lalu isi nilainya.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.ganti-dengan-anon-key

# Alamat asal situs, dipakai untuk menyusun tautan pemulihan kata sandi.
# Contoh: https://sdsbanjaragung.sch.id
# Bila dikosongkan, alamat disimpulkan dari header permintaan (cukup untuk lokal).
NEXT_PUBLIC_SITE_URL=

# Hanya untuk keperluan server (migrasi / seed / admin task).
# JANGAN pernah dipakai di komponen client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Catatan:
# Selama dua variabel NEXT_PUBLIC_* di atas belum diisi, website tetap
# berjalan memakai data placeholder di lib/data/fallback.ts (mode demo).
#
# Agar email "lupa kata sandi" benar-benar terkirim, SMTP harus diatur di
# Dashboard Supabase (bukan di file ini):
#   Authentication > Emails > SMTP Settings
# Lalu tambahkan alamat berikut ke Authentication > URL Configuration >
# Redirect URLs:
#   http://localhost:3000/auth/confirm
#   https://<domain-sekolah>/auth/confirm
# Tanpa SMTP kustom, Supabase hanya mengirim email ke alamat anggota project.
# ---------------------------------------------------------------------------
